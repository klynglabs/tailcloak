{
  "name": "tailcloak-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "start": "turbo run start --filter='./examples/*'",
    "dev": "turbo run dev --filter='./packages/*'",
    "test": "turbo run test",
    "typecheck": "tsc && turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint && tsc && turbo run typecheck test",
    "e2e": "turbo run e2e",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install && oxfmt",
    "release": "bun run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
